# --- Local infra ---
DATABASE_URL=postgresql://lgm:lgm@localhost:5432/lgm
REDIS_URL=redis://localhost:6379

# --- Auth (single-user MVP) ---
# Generate a new random secret (at least 32 bytes). Never reuse the published example.
# The same value is used to sign in via /login.
SESSION_SECRET=

# --- Vendor API keys ---
APOLLO_API_KEY=
REACHINBOX_API_KEY=
REOON_API_KEY=
ANTHROPIC_API_KEY=

# --- Google Sheets export (optional; CSV export still works without it) ---
# Path to GCP service account JSON file.
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/gcp-sa.json
# Sheets are shared with this email (writer access).
GOOGLE_SHEETS_OWNER_EMAIL=

# --- Defaults ---
DEFAULT_TARGET_PROSPECTS=500
DEFAULT_DAILY_CAP=40

# --- Models ---
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# --- Sync ---
REACHINBOX_SYNC_INTERVAL_MIN=15
